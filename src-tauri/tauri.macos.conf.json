{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Thoughts",
        "width": 1320,
        "height": 860,
        "minWidth": 920,
        "minHeight": 600,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings",
        "Resources/ar.lproj/InfoPlist.strings": "./macos/ar.lproj/InfoPlist.strings"
      }
    }
  }
}
